def find_max_subarray(nums):
    # Если массив пуст, возвращаем 0
    if not nums:
        return 0
    
    # Инициализируем переменные первым элементом
    current_sum = max_sum = nums[0]
    
    # Проходим по массиву, начиная со второго элемента
    for x in nums[1:]:
        # Выбираем: начать заново с x или прибавить x к накопленной сумме
        current_sum = max(x, current_sum + x)
        
        # Обновляем глобальный максимум, если текущая сумма стала больше
        max_sum = max(max_sum, current_sum)
        
    return max_sum

# Пример использования:
numbers = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
result = find_max_subarray(numbers)

print(f"Максимальная сумма подмассива: {result}")
# Для этого примера ответ 6, так как [4, -1, 2, 1] дает в сумме 6.
